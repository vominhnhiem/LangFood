<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền muốn rút"
            android:textColor="#333333"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ví dụ: 100000"
            android:inputType="number"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tên ngân hàng"
            android:textColor="#333333"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBankName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ví dụ: Vietcombank, MB, ..."
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Số tài khoản"
            android:textColor="#333333"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAccountNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nhập số tài khoản ngân hàng"
            android:inputType="number"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tên chủ tài khoản"
            android:textColor="#333333"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAccountName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nhập tên không dấu (VD: NGUYEN VAN A)"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ghi chú (Không bắt buộc)"
            android:textColor="#333333"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nhập ghi chú nếu có"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="* Yêu cầu rút tiền sẽ được gửi tới Admin để phê duyệt. Số tiền sẽ bị trừ tạm thời khỏi ví."
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:fontStyle="italic" />

    </LinearLayout>
</ScrollView>
