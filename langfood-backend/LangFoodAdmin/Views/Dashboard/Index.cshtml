@model LangFoodAdmin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800 fw-bold">Tổng quan hệ thống</h1>
    <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-download fa-sm text-white-50 me-1"></i> Xuất báo cáo
    </a>
</div>

<!-- Thẻ Card thống kê -->
<div class="row gap-4 mb-4" style="flex-wrap: nowrap; overflow-x: auto; padding-bottom: 10px;">
    <!-- Card 1 -->
    <div class="col-xl-4 col-md-6 mb-4 mb-xl-0" style="min-width: 280px;">
        <div class="admin-card border-left-primary h-100 py-2">
            <div class="stat-card">
                <div class="stat-content flex-grow-1">
                    <p class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="font-size: 0.8rem;">Tổng đơn (Tháng)</p>
                    <h3 class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalOrdersThisMonth</h3>
                </div>
                <div class="stat-icon" style="color: #4e73df; background-color: rgba(78, 115, 223, 0.1);">
                    <i class="fas fa-calendar"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2 (Thay thế Card 3 cũ) -->
    <div class="col-xl-4 col-md-6 mb-4 mb-xl-0" style="min-width: 280px;">
        <div class="admin-card border-left-info h-100 py-2">
            <div class="stat-card">
                <div class="stat-content flex-grow-1">
                    <p class="text-xs font-weight-bold text-info text-uppercase mb-1" style="font-size: 0.8rem;">Tổng người dùng</p>
                    <h3 class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalUsers</h3>
                </div>
                <div class="stat-icon" style="color: #36b9cc; background-color: rgba(54, 185, 204, 0.1);">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3 (Thay thế Card 4 cũ) -->
    <div class="col-xl-4 col-md-6 mb-4 mb-xl-0" style="min-width: 280px;">
        <a asp-controller="Shippers" asp-action="Index" class="text-decoration-none">
            <div class="admin-card border-left-warning h-100 py-2">
                <div class="stat-card">
                    <div class="stat-content flex-grow-1">
                        <p class="text-xs font-weight-bold text-warning text-uppercase mb-1" style="font-size: 0.8rem;">Shipper chờ duyệt</p>
                        <h3 class="h5 mb-0 font-weight-bold text-gray-800">@Model.PendingShipperCount</h3>
                    </div>
                    <div class="stat-icon" style="color: #f6c23e; background-color: rgba(246, 194, 62, 0.1);">
                        <i class="fas fa-motorcycle"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Bảng Đơn hàng mới nhất -->
<div class="row">
    <div class="col-12">
        <div class="admin-card shadow mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="m-0 font-weight-bold" style="color: var(--accent-color);">Đơn hàng mới nhất</h6>
                <a href="/Orders" class="btn btn-sm btn-outline-primary" style="color: var(--accent-color); border-color: var(--accent-color);">Xem tất cả</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Cửa hàng</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LatestOrders != null && Model.LatestOrders.Any())
                        {
                            foreach (var order in Model.LatestOrders)
                            {
                                var buyerName = order.Buyer?.FullName ?? order.BuyerName ?? "N/A";
                                var shopName = order.Shop?.Name ?? "N/A";
                                var statusBadgeClass = order.Status switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "Paid" => "bg-primary text-white",
                                    "Preparing" => "bg-info text-dark",
                                    "Ready" => "bg-info text-dark",
                                    "Shipping" => "bg-info text-dark",
                                    "Delivered" => "bg-success text-white",
                                    "Cancelled" => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };
                                var statusLabel = order.Status switch
                                {
                                    "Pending" => "Chờ xác nhận",
                                    "Paid" => "Đã thanh toán",
                                    "Preparing" => "Đang chuẩn bị",
                                    "Ready" => "Chuẩn bị xong",
                                    "Shipping" => "Đang giao",
                                    "Delivered" => "Đã giao",
                                    "Cancelled" => "Đã hủy",
                                    _ => order.Status
                                };

                                <tr>
                                    <td class="fw-bold">#LF-@order.Id</td>
                                    <td>@buyerName</td>
                                    <td>@shopName</td>
                                    <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0")₫</td>
                                    <td><span class="badge @statusBadgeClass">@statusLabel</span></td>
                                    <td>
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info text-white"><i class="fas fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">Không có đơn hàng nào gần đây.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
