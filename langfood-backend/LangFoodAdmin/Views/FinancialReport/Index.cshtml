@model LangFoodAdmin.Models.FinancialReportViewModel
@{
    ViewData["Title"] = "Báo cáo tài chính";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800 fw-bold">Báo cáo tài chính</h1>
    </div>

    <!-- Bộ lọc thời gian -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold text-secondary" for="timePeriod">
                        <i class="fa-solid fa-filter me-1" style="color: var(--accent-color, #F24E1E);"></i> Lọc theo thời gian:
                    </label>
                </div>
                <div class="col-auto">
                    <select class="form-select border-2" id="timePeriod" name="timePeriod" style="border-radius: 8px; border-color: #E2E8F0; min-width: 180px;">
                        <option value="all" selected="@(ViewBag.CurrentTimePeriod == "all")">Tất cả thời gian</option>
                        <option value="today" selected="@(ViewBag.CurrentTimePeriod == "today")">Hôm nay</option>
                        <option value="month" selected="@(ViewBag.CurrentTimePeriod == "month")">Tháng này</option>
                        <option value="year" selected="@(ViewBag.CurrentTimePeriod == "year")">Năm nay</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn text-white fw-bold px-3 d-flex align-items-center" style="background-color: var(--accent-color, #F24E1E); border-color: var(--accent-color, #F24E1E); border-radius: 8px; height: 38px;">
                        <i class="fa-solid fa-magnifying-glass me-2"></i> Lọc dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2 Thẻ Card thống kê -->
    <div class="row mb-4">
        <!-- Card 1: Tổng doanh thu hệ thống -->
        <div class="col-xl-6 col-md-6 mb-4">
            <div class="admin-card border-left-success h-100 py-2">
                <div class="stat-card">
                    <div class="stat-content flex-grow-1">
                        <p class="text-xs font-weight-bold text-success text-uppercase mb-1" style="font-size: 0.8rem;">Tổng doanh thu hệ thống</p>
                        <h3 class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalRevenue.ToString("N0")₫</h3>
                    </div>
                    <div class="stat-icon" style="color: #1cc88a; background-color: rgba(28, 200, 138, 0.1);">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Đơn hàng hoàn thành -->
        <div class="col-xl-6 col-md-6 mb-4">
            <div class="admin-card border-left-primary h-100 py-2">
                <div class="stat-card">
                    <div class="stat-content flex-grow-1">
                        <p class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="font-size: 0.8rem;">Đơn hàng đã hoàn thành</p>
                        <h3 class="h5 mb-0 font-weight-bold text-gray-800">@Model.CompletedOrdersCount</h3>
                    </div>
                    <div class="stat-icon" style="color: #4e73df; background-color: rgba(78, 115, 223, 0.1);">
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng doanh thu chi tiết -->
    <div class="row">
        <div class="col-12">
            <div class="admin-card shadow mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0 text-dark">Doanh thu tóm tắt theo từng tháng</h5>
                </div>
                <div class="table-responsive px-4 pb-4">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tháng/Năm</th>
                                <th>Tổng đơn</th>
                                <th>Doanh thu thu về</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.MonthlySummaries.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">Không có dữ liệu báo cáo tài chính.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var summary in Model.MonthlySummaries)
                                {
                                    <tr>
                                        <td class="fw-bold text-secondary">@summary.MonthYear</td>
                                        <td>@summary.TotalOrders.ToString("N0")</td>
                                        <td class="fw-bold text-success text-success-emphasis">@summary.Revenue.ToString("N0")₫</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
