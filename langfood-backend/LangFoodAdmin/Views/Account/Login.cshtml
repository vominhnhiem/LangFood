@model LangFoodAdmin.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Làng Food Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa; /* Nền xám nhạt (bg-light) */
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); /* Đổ bóng mượt mà (shadow-sm) */
            background-color: #ffffff; /* Khối màu trắng */
            width: 100%;
            max-width: 420px;
            padding: 40px 30px;
        }

        .brand-logo {
            font-size: 2rem;
            font-weight: 800;
            color: #F24E1E; /* Màu Cam chủ đạo */
            text-align: center;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-orange {
            background-color: #F24E1E; /* Màu Cam chủ đạo */
            border-color: #F24E1E;
            color: #ffffff;
            font-weight: 700;
            padding: 12px;
            border-radius: 8px;
            width: 100%;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .btn-orange:hover, .btn-orange:focus {
            background-color: #d84315;
            border-color: #d84315;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(242, 78, 30, 0.2);
        }

        .form-floating > .form-control {
            border-radius: 8px;
            border: 1px solid #ced4da;
        }

        .form-floating > .form-control:focus {
            border-color: #F24E1E;
            box-shadow: 0 0 0 0.25rem rgba(242, 78, 30, 0.15);
        }

        .form-check-input:checked {
            background-color: #F24E1E;
            border-color: #F24E1E;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Logo -->
        <div class="brand-logo">
            <i class="fa-solid fa-utensils me-2"></i>Làng Food
        </div>
        
        <h5 class="text-center fw-semibold text-secondary mb-4">Trang Đăng Nhập Quản Trị</h5>
        
        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            @Html.AntiForgeryToken()
            
            <!-- Validation Summary -->
            <div asp-validation-summary="All" class="text-danger mb-3 small fw-medium"></div>

            <!-- Email (Floating Label) -->
            <div class="form-floating mb-3">
                <input asp-for="Email" type="email" class="form-control" id="floatingEmail" placeholder="name@example.com" required />
                <label asp-for="Email" for="floatingEmail">Địa chỉ Email</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Password (Floating Label) -->
            <div class="form-floating mb-3">
                <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Mật khẩu" required />
                <label asp-for="Password" for="floatingPassword">Mật khẩu</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Remember Me -->
            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                <label class="form-check-label text-muted small" for="rememberMe">Duy trì đăng nhập</label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-orange">
                ĐĂNG NHẬP HỆ THỐNG
            </button>
        </form>
    </div>

</body>
</html>
