@model LangFoodAdmin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Trung tâm Điều hành - Làng Food";
}

<div class="container-fluid py-4">
    <!-- Phần 1: Lời chào & Thông tin nhanh -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8 col-12">
            <h2 class="fw-bold text-dark" id="welcome-text">Chào buổi sáng, <span style="color: var(--accent-color);">Admin!</span></h2>
            <p class="text-muted mb-0"><i class="far fa-calendar-alt me-2"></i> <span id="current-date">Thứ Ba, 12 Tháng 5, 2026</span> | Hệ thống đang hoạt động ổn định.</p>
        </div>
        <div class="col-md-4 col-12 text-md-end text-start mt-3 mt-md-0">
            <div class="d-inline-flex align-items-center bg-white shadow-sm px-3 py-2 border" style="border-radius: 12px;">
                <div class="me-3 bg-light p-2 rounded-3 text-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; color: var(--accent-color) !important;">
                    <i class="far fa-clock fs-5"></i>
                </div>
                <div class="text-start">
                    <span class="d-block small text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Giờ hệ thống</span>
                    <span class="fs-5 fw-bold text-dark" id="current-time" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">00:00:00</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Phần 1: Việc cần làm (Pending Actions) -->
    <div class="row mb-5">
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm" style="background-color: #FFF9E6; border-left: 5px solid #FFC107 !important; border-radius: 12px;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center mb-1">
                            <h6 class="fw-bold mb-0 text-warning-emphasis">Hồ sơ Shipper</h6>
                            @if (Model.PendingShipperCount > 0)
                            {
                                <span class="ms-2 badge rounded-pill text-white fw-bold pending-count-badge" style="background-color: #FFC107; font-size: 0.75rem;">@Model.PendingShipperCount mới</span>
                            }
                        </div>
                        <p class="small mb-2 text-muted">Đang chờ duyệt danh tính.</p>
                        <a asp-controller="Shippers" asp-action="Index" class="btn btn-sm btn-warning text-white fw-bold px-3" style="border-radius: 8px;">Xử lý ngay</a>
                    </div>
                    <div class="ms-3 position-relative">
                        <i class="fas fa-id-card fa-2x text-warning opacity-50"></i>
                        @if (Model.PendingShipperCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger blink-dot" style="font-size: 0.6rem; padding: 4px 5px;">!</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm" style="background-color: #EBFBEE; border-left: 5px solid #28A745 !important; border-radius: 12px;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center mb-1">
                            <h6 class="fw-bold mb-0 text-success-emphasis">Yêu cầu rút tiền</h6>
                            @if (Model.PendingWithdrawalCount > 0)
                            {
                                <span class="ms-2 badge rounded-pill text-white fw-bold pending-count-badge" style="background-color: #28A745; font-size: 0.75rem;">@Model.PendingWithdrawalCount mới</span>
                            }
                        </div>
                        <p class="small mb-2 text-muted">Từ người dùng đã sẵn sàng.</p>
                        <a asp-controller="Finance" asp-action="Index" class="btn btn-sm btn-success fw-bold px-3" style="border-radius: 8px;">Duyệt lệnh</a>
                    </div>
                    <div class="ms-3 position-relative">
                        <i class="fas fa-wallet fa-2x text-success opacity-50"></i>
                        @if (Model.PendingWithdrawalCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger blink-dot" style="font-size: 0.6rem; padding: 4px 5px;">!</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Phần 2: Lối tắt truy cập nhanh (Quick Shortcuts) -->
        <div class="col-lg-8 mb-4">
            <h5 class="fw-bold mb-4">Lối tắt truy cập nhanh</h5>
            <div class="row g-4">
                <div class="col-6 col-md-4">
                    <a href="javascript:void(0)" class="quick-tile shadow-sm" data-bs-toggle="modal" data-bs-target="#addPartnerModal">
                        <i class="fas fa-store"></i>
                        <span>Thêm Đối Tác Mới</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a href="/Settings#broadcast-section" class="quick-tile shadow-sm">
                        <i class="fas fa-bullhorn"></i>
                        <span>Gửi Thông Báo Toàn Sàn</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="Settings" asp-action="Index" class="quick-tile shadow-sm">
                        <i class="fas fa-cog"></i>
                        <span>Cài Đặt Hệ Thống</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="Orders" asp-action="Index" class="quick-tile shadow-sm">
                        <i class="fas fa-shipping-fast"></i>
                        <span>Quản Lý Vận Chuyển</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="FinancialReport" asp-action="Index" class="quick-tile shadow-sm">
                        <i class="fas fa-chart-line"></i>
                        <span>Xem Báo Cáo Tài Chính</span>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a asp-controller="Permission" asp-action="Index" class="quick-tile shadow-sm">
                        <i class="fas fa-user-shield"></i>
                        <span>Phân Quyền Admin</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Phần 3: Nhịp đập hệ thống (Live Activity Timeline) -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Nhịp đập hệ thống</h5>
                </div>
                <div class="card-body pt-0">
                    <div class="activity-timeline">
                        @if (Model.LatestLogs != null && Model.LatestLogs.Any())
                        {
                            for (int i = 0; i < Model.LatestLogs.Count; i++)
                            {
                                var log = Model.LatestLogs[i];
                                var isLast = (i == Model.LatestLogs.Count - 1);
                                var dotColor = log.LogType switch
                                {
                                    LangFood.Shared.Models.LogType.Order => "bg-success",
                                    LangFood.Shared.Models.LogType.Shipper => "bg-warning",
                                    LangFood.Shared.Models.LogType.Shop => "bg-info",
                                    LangFood.Shared.Models.LogType.Danger => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <div class="timeline-item @(isLast ? "last" : "")">
                                    <span class="timeline-dot @dotColor"></span>
                                    <div class="timeline-content">
                                        <p class="mb-0 fw-bold">@log.Content</p>
                                        <span class="text-muted small">@LangFoodAdmin.Helpers.StatusHelper.ToFriendlyTimeAgo(log.CreatedAt)</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small text-center py-3">Chưa có hoạt động nào được ghi nhận.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Đối Tác Mới -->
<div class="modal fade" id="addPartnerModal" tabindex="-1" aria-labelledby="addPartnerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white" style="background-color: var(--accent-color);">
                <h5 class="modal-title fw-bold" id="addPartnerModalLabel"><i class="fas fa-plus-circle me-2"></i>Thêm Đối Tác & Gian Hàng Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formAddPartner" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row">
                        <!-- Cột trái: Thông tin tài khoản -->
                        <div class="col-md-6 border-end">
                            <h6 class="fw-bold mb-3 text-muted"><i class="fas fa-user-circle me-2"></i>Thông tin tài khoản</h6>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Số điện thoại (Tên đăng nhập)</label>
                                <input type="text" name="PhoneNumber" class="form-control rounded-3" placeholder="Ví dụ: 0987654321" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Họ tên chủ quán</label>
                                <input type="text" name="FullName" class="form-control rounded-3" placeholder="Nhập tên người đại diện" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Mật khẩu khởi tạo</label>
                                <input type="password" name="Password" class="form-control rounded-3" placeholder="Ít nhất 6 ký tự" required>
                            </div>
                        </div>
                        <!-- Cột phải: Thông tin gian hàng -->
                        <div class="col-md-6 ps-md-4">
                            <h6 class="fw-bold mb-3 text-muted"><i class="fas fa-store-alt me-2"></i>Thông tin gian hàng</h6>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Tên gian hàng / Quán ăn</label>
                                <input type="text" name="ShopName" class="form-control rounded-3" placeholder="Ví dụ: Bún đậu Mắm Tôm Cô Ba" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Địa chỉ</label>
                                <input type="text" name="Address" class="form-control rounded-3" placeholder="Nhập địa chỉ chi tiết" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Ảnh đại diện quán</label>
                                <input type="file" name="ShopImage" class="form-control rounded-3" accept="image/*">
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Mô tả ngắn</label>
                                <textarea name="Description" class="form-control rounded-3" rows="2" placeholder="Quán chuyên về món gì..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary fw-bold px-4 rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3" style="background-color: var(--accent-color); border-color: var(--accent-color);">
                        <i class="fas fa-check-circle me-2"></i>Tạo Đối Tác
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // SignalR Connection and Listener
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/orderHub")
                .configureLogging(signalR.LogLevel.Information)
                .build();

            connection.on("ReceiveNewLog", function (log) {
                let dotColor = "bg-secondary";
                if (log.type === "Order") dotColor = "bg-success";
                else if (log.type === "Shipper") dotColor = "bg-warning";
                else if (log.type === "Shop") dotColor = "bg-info";
                else if (log.type === "Danger") dotColor = "bg-danger";

                // Create dynamic timeline element
                const newItem = $(`
                    <div class="timeline-item" style="display: none;">
                        <span class="timeline-dot ${dotColor}"></span>
                        <div class="timeline-content">
                            <p class="mb-0 fw-bold">${log.content}</p>
                            <span class="text-muted small">${log.time || 'Vừa xong'}</span>
                        </div>
                    </div>
                `);

                const timeline = $(".activity-timeline");
                timeline.prepend(newItem);
                newItem.slideDown(400);

                const items = timeline.children(".timeline-item");
                if (items.length > 5) {
                    items.last().fadeOut(400, function() {
                        $(this).remove();
                        adjustTimelineClasses();
                    });
                } else {
                    adjustTimelineClasses();
                }
            });

            function adjustTimelineClasses() {
                const timeline = $(".activity-timeline");
                const items = timeline.children(".timeline-item");
                items.removeClass("last");
                items.last().addClass("last");
            }

            connection.start().then(function () {
                console.log("Connected to SignalR orderHub successfully!");
            }).catch(function (err) {
                console.error("SignalR connection error: ", err.toString());
            });

            $('#formAddPartner').on('submit', function (e) {
                e.preventDefault();
                
                var formData = new FormData(this);
                
                // Hiển thị trạng thái đang xử lý
                var btnSubmit = $(this).find('button[type="submit"]');
                var originalText = btnSubmit.html();
                btnSubmit.html('<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...').attr('disabled', true);

                $.ajax({
                    url: '/Partners/Create',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                            $('#addPartnerModal').modal('hide');
                            $('#formAddPartner')[0].reset();
                            // Có thể reload trang hoặc cập nhật danh sách tại đây
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("Có lỗi xảy ra trong quá trình kết nối với máy chủ.");
                    },
                    complete: function() {
                        btnSubmit.html(originalText).attr('disabled', false);
                    }
                });
            });

            // Cập nhật lời chào, ngày tháng và giờ thực hiển thị
            function updateWelcomeDateTime() {
                var now = new Date();
                var hours = now.getHours();
                
                // 1. Tối ưu lời chào động theo buổi
                var greeting = "Chào ngày mới"; // Mặc định từ 0h - 3h sáng
                if (hours >= 4 && hours < 12) {
                    greeting = "Chào buổi sáng"; // Từ 4h - 11h
                } else if (hours >= 12 && hours < 18) {
                    greeting = "Chào buổi chiều"; // Từ 12h - 17h
                } else if (hours >= 18 && hours <= 23) {
                    greeting = "Chào buổi tối"; // Từ 18h - 23h
                }
                $('#welcome-text').html(greeting + ', <span style="color: var(--accent-color);">Admin!</span>');
                
                // 2. Định dạng ngày tháng tiếng Việt
                var days = ["Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy"];
                var dayName = days[now.getDay()];
                var dd = String(now.getDate()).padStart(2, '0');
                var mm = String(now.getMonth() + 1).padStart(2, '0');
                var yyyy = now.getFullYear();
                var dateStr = dayName + ", Ngày " + dd + " Tháng " + mm + " Năm " + yyyy;
                $('#current-date').text(dateStr);

                // 3. Định dạng giờ hiển thị (HH:mm:ss) ở phía bên phải
                var hh = String(hours).padStart(2, '0');
                var min = String(now.getMinutes()).padStart(2, '0');
                var ss = String(now.getSeconds()).padStart(2, '0');
                $('#current-time').text(hh + ":" + min + ":" + ss);
            }

            // Chạy ngay lập tức khi tải trang
            updateWelcomeDateTime();

            // Cập nhật lại sau mỗi 1 giây (1000ms) để đồng hồ chạy mượt mà
            setInterval(updateWelcomeDateTime, 1000);
        });
    </script>
}

<style>
    .quick-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #FFFFFF;
        padding: 30px 20px;
        border-radius: 16px;
        text-decoration: none;
        color: #333;
        transition: all 0.3s ease;
        height: 100%;
        text-align: center;
    }

    .quick-tile i {
        font-size: 2.5rem;
        color: var(--accent-color);
        margin-bottom: 15px;
        transition: transform 0.3s ease;
    }

    .quick-tile span {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .quick-tile:hover {
        transform: translateY(-8px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        color: var(--accent-color);
    }

    .quick-tile:hover i {
        transform: scale(1.1);
    }

    /* Timeline Styles */
    .activity-timeline {
        position: relative;
        padding-left: 30px;
    }

    .activity-timeline::before {
        content: '';
        position: absolute;
        left: 7px;
        top: 10px;
        bottom: 10px;
        width: 2px;
        background: #E9ECEF;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 25px;
    }

    .timeline-dot {
        position: absolute;
        left: -30px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 3px solid #FFF;
        z-index: 1;
    }

    .timeline-content p {
        font-size: 0.9rem;
        line-height: 1.4;
    }

    .timeline-item.last {
        padding-bottom: 0;
    }

    /* ===== Pending Badge Animations ===== */
    @@keyframes blinkDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.7); }
    }

    .blink-dot {
        animation: blinkDot 1.2s ease-in-out infinite;
    }

    @@keyframes badgePop {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.12); }
    }

    .pending-count-badge {
        animation: badgePop 2s ease-in-out infinite;
    }
</style>
